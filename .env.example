# ============================================================
# 环境变量模板 —— 复制成 .env 后填真实值
#     cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。
#
# ⚠️ 财务项目尤其注意：这个文件里会有 API Key，
#    绝不能提交到 git，也绝不能把 .env 发给别人。
# ============================================================

# ---------- 模型服务商：硅基流动 ----------
# 申请：https://cloud.siliconflow.cn 注册 → 左侧「API 密钥」→ 新建（sk- 开头）
# 一个 key 同时供 对话 / 发票识别 / 向量化 三处使用
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 模型名（不硬编码，服务商会随时上下架模型）----------
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# ---------- 应用 ----------
APP_NAME=finance-agent
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- 数据存储 ----------
# SQLite 单文件，零配置；换 PostgreSQL 只改这一行
DATABASE_URL=sqlite:///data/ledger.db
CHROMA_DIR=./data/chroma

# ---------- RAG 切分参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
